{
  "name": "dentiva-pro",
  "private": true,
  "version": "0.1.0-dev",
  "description": "Dentiva Pro offline desktop application (development build)",
  "author": "Shohan Khan",
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.json",
    "build": "vite build && tsc -p tsconfig.desktop.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "audit:deps": "npm audit --audit-level=high",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "audit:licenses": "node scripts-audit-licenses.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.0",
    "vitest": "5.0.2"
  },
  "build": {
    "appId": "com.shohankhan.dentivapro",
    "productName": "Dentiva Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
